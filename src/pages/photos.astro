---
import BaseLayout from '../layouts/BaseLayout.astro';
// Archive items are rendered by the client script and cannot receive Astro's scope attribute.
import '../styles/photos.css';
---

<BaseLayout title="Фото — архив">
  <div class="nav">
    <button class="nav-btn" id="back" title="Назад" disabled>‹</button>
    <button class="nav-btn" id="forward" title="Вперёд" disabled>›</button>
    <div class="crumbs" id="crumbs"></div>
  </div>

  <aside class="sidebar" id="sidebar"></aside>

  <main class="main">
    <div class="grid" id="grid"></div>
  </main>

  <div class="statusbar" id="statusbar"></div>

  <div class="lightbox" id="lightbox">
    <img id="lightbox-img" alt="" />
    <div class="lb-caption" id="lightbox-caption"></div>
  </div>

  <script src="../scripts/photos.js"></script>
</BaseLayout>
