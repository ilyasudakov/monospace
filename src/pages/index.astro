---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/globals.css';
// Window markup is created at runtime, so these selectors must stay global.
import '../styles/window.css';

const baseUrl = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const route = (name: string) => `${baseUrl}${name}/`;
---

<BaseLayout
  title="Ilya Sudakov"
  description="Ilya Sudakov — personal playground"
  bodyClass="playground"
>
  <Fragment slot="head">
    <link rel="preload" as="image" href={`${baseUrl}assets/autumn-wide-background.webp`} media="(min-width: 900px)" fetchpriority="high" />
    <link rel="preload" as="image" href={`${baseUrl}assets/autumn-background.webp`} media="(max-width: 899px)" fetchpriority="high" />
  </Fragment>
  <button class="language-switch video-switch theme-switch" data-theme-switch type="button" aria-pressed="false" aria-label="Включить тёмную тему" title="Включить тёмную тему">
      <svg class="theme-moon" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"><path d="M13.5 9.3A5.8 5.8 0 0 1 6.7 2.5a5.8 5.8 0 1 0 6.8 6.8Z"/></svg>
      <svg class="theme-sun" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><circle cx="8" cy="8" r="3"/><path d="M8 1v1m0 12v1M1 8h1m12 0h1M3 3l.7.7m8.6 8.6.7.7M3 13l.7-.7m8.6-8.6L13 3"/></svg>
  </button>
  <div class="page-controls">
    <button class="language-switch video-switch view-reset" data-view-reset type="button" aria-label="Сбросить вид" title="Сбросить вид (R)" hidden>
      <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 2H2v3m9-3h3v3M2 11v3h3m9-3v3h-3"/><circle cx="8" cy="8" r="2"/></svg>
    </button>
    <button class="language-switch video-switch" data-video-switch data-paused="true" type="button" aria-label="Запустить фоновое видео" title="Запустить фоновое видео">
      <svg class="play-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3.5 12 8l-7 4.5z" fill="currentColor" /></svg>
      <svg class="pause-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 4v8M11 4v8" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
    </button>
    <button class="language-switch video-switch music-switch" data-music-switch data-paused="true" type="button" aria-pressed="false" aria-label="Включить музыку · Outside" title="Включить музыку · Outside">
      <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M7 3 3.5 6H1.5v4h2L7 13Z"/><path class="music-on" d="M10 5.5a4 4 0 0 1 0 5m2-7a7 7 0 0 1 0 9"/><path class="music-off" d="m10 6 4 4m0-4-4 4"/></svg>
    </button>
    <div class="language-switch language-links" data-language-switch data-language="ru" role="group" aria-label="Language / Язык">
      <button class="language-option" data-language-option="ru" type="button" aria-pressed="true" aria-label="Русский">RU</button>
      <button class="language-option" data-language-option="en" type="button" aria-pressed="false" aria-label="English">EN</button>
    </div>
  </div>
  <audio data-background-music data-src={`${baseUrl}assets/outside-01-25.m4a`} preload="none" loop></audio>
  <div class="viewport" id="viewport" style={`--wallpaper: url('${baseUrl}assets/autumn-background.webp'); --wallpaper-wide: url('${baseUrl}assets/autumn-wide-background.webp'); --wallpaper-dark: url('${baseUrl}assets/winter-background.webp'); --wallpaper-dark-wide: url('${baseUrl}assets/winter-wide-background.webp')`}>
    <video class="wallpaper-video" data-background-video data-src={`${baseUrl}assets/autumn-mobile-web.mp4`} data-wide-src={`${baseUrl}assets/autumn-wide-web.mp4`} data-poster={`${baseUrl}assets/autumn-background.webp`} data-wide-poster={`${baseUrl}assets/autumn-wide-background.webp`} data-dark-src={`${baseUrl}assets/winter-mobile-web.mp4`} data-dark-wide-src={`${baseUrl}assets/winter-wide-web.mp4`} data-dark-poster={`${baseUrl}assets/winter-background.webp`} data-dark-wide-poster={`${baseUrl}assets/winter-wide-background.webp`} muted loop playsinline preload="none" aria-hidden="true" tabindex="-1"></video>
    <div class="canvas" id="canvas">
      <div class="sticker sticker--paper" data-x="-220" data-y="-200" data-rot="-2.5">
        <p>Привет, меня зовут <strong>Илья</strong>.</p>
        <p>
          Продакт-инженер в <a
            href="https://improvado.io"
            target="_blank"
            rel="noopener"
            class="paper-link">Improvado</a
          >, из Санкт-Петербурга. Люблю решать сложные задачи и делать полезные продукты end-to-end:
          дизайн, код, поддержка.
        </p>
        <p>
          Можно связаться со мной <a class="paper-link" href="mailto:ilyasudakov.dev@gmail.com">по почте</a> <span>или в</span> <a class="paper-link" href="https://t.me/ilyasudakov" target="_blank" rel="noopener">Telegram</a>.
        </p>
      </div>

      <a
        class="sticker sticker--chip chip--cv"
        href={`${baseUrl}#resume`}
        data-window={route('cv')}
        data-window-title="Резюме"
        data-x="122"
        data-y="-144"
        data-rot="2"
      >
        <span>Резюме</span>
      </a>

      <a
        class="sticker sticker--chip chip--work"
        href={`${baseUrl}#portfolio`}
        data-window={route('work')}
        data-window-title="Портфолио"
        data-x="116"
        data-y="-200"
        data-rot="-2"
      >
        <span>Портфолио</span>
      </a>

      <details class="sticker sticker--links" data-x="122" data-y="-86" data-rot="1" data-links-menu>
        <summary class="sticker--chip chip--cv chip--links-toggle"><span>Ссылки</span><svg class="links-chevron" viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
        <nav class="profile-links" aria-label="Ссылки на профили">
          <a href="https://github.com/ilyasudakov" target="_blank" rel="noopener">GitHub <span aria-hidden="true">↗</span></a>
          <a href="https://www.linkedin.com/in/ilyasudakov/" target="_blank" rel="noopener">LinkedIn <span aria-hidden="true">↗</span></a>
          <a href="https://t.me/ilyasudakov" target="_blank" rel="noopener">Telegram <span aria-hidden="true">↗</span></a>
          <a href="mailto:ilyasudakov.dev@gmail.com"><span>Почта</span> <span aria-hidden="true">↗</span></a>
        </nav>
      </details>

      <div class="sticker sticker--note note--pink" data-x="-220" data-y="140" data-rot="-5">
        <span class="note-label">интерес</span>
        <strong>Дизайн</strong>
      </div>

      <div class="sticker sticker--note note--yellow" data-x="-60" data-y="140" data-rot="-2">
        <span class="note-label">интерес</span>
        <strong>Музыка</strong>
      </div>
    </div>
  </div>

  <script src="../scripts/canvas.js"></script>
  <script src="../scripts/background-video.js"></script>
  <script src="../scripts/background-music.js"></script>
  <script>
    const linksMenu = document.querySelector<HTMLDetailsElement>('[data-links-menu]');
    let outsidePress: { x: number; y: number; moved: boolean } | null = null;
    document.addEventListener('pointerdown', event => {
      outsidePress = linksMenu?.open && !linksMenu.contains(event.target as Node)
        ? { x: event.clientX, y: event.clientY, moved: false } : null;
    }, { capture: true });
    document.addEventListener('pointermove', event => {
      if (outsidePress && Math.hypot(event.clientX - outsidePress.x, event.clientY - outsidePress.y) > 4) outsidePress.moved = true;
    }, { capture: true });
    document.addEventListener('click', event => {
      if (linksMenu?.open && !linksMenu.contains(event.target as Node)
        && (event.detail === 0 || (outsidePress && !outsidePress.moved))) linksMenu.open = false;
      outsidePress = null;
    });
    linksMenu?.addEventListener('keydown', event => {
      if (event.key !== 'Escape' || !linksMenu.open) return;
      event.stopPropagation();
      linksMenu.open = false;
      linksMenu.querySelector('summary')?.focus();
    });
  </script>
</BaseLayout>

<style>
  .theme-switch { position: fixed; top: 20px; left: 24px; z-index: 2100; }
  .page-controls {
    position: fixed;
    top: 20px;
    right: 24px;
    z-index: 2100;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .language-switch {
    display: grid;
    place-items: center;
    width: 48px;
    height: 30px;
    padding: 0;
    overflow: hidden;
    isolation: isolate;
    border: 0;
    border-radius: 20px;
    background: rgba(255,255,255,.55);
    backdrop-filter: blur(12px);
    box-shadow: inset 0 0 0 1px rgba(53,81,106,.35), inset 0 1px 0 rgba(255,255,255,.8), 0 4px 10px -6px rgba(25,55,85,.2);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: .06em;
    color: #35516a;
    cursor: pointer;
    transition: background 160ms ease;
  }
  .language-switch:hover { background: rgba(255,255,255,.85); color: #243d54; }
  .language-switch:focus-visible { outline: 2px solid #355774; outline-offset: 3px; }
  .language-links {
    display: flex;
    align-items: center;
    column-gap: 0;
    width: auto;
    height: 32px;
    padding: 0;
    overflow: visible;
    border-radius: 0;
    background: transparent;
    backdrop-filter: none;
    box-shadow: none;
    color: #fff;
    font-size: 12px;
    letter-spacing: .04em;
    text-shadow: 0 0 2px rgba(0,0,0,.9), 0 1px 3px rgba(0,0,0,.65);
  }
  .language-links:hover { background: transparent; color: #fff; }
  .language-option {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 0;
    background: transparent;
    font: inherit;
    letter-spacing: inherit;
    color: inherit;
    text-shadow: inherit;
    text-decoration: underline;
    text-underline-offset: 4px;
    cursor: pointer;
  }
  .language-option + .language-option { margin-left: -2px; }
  .language-option[aria-pressed="true"] { font-weight: 700; }
  .language-option[aria-pressed="false"] { opacity: .7; }
  .language-option:hover, .language-option:focus-visible { opacity: 1; }
  .language-option:focus-visible { outline: 2px solid #fff; outline-offset: 2px; border-radius: 2px; }
  .video-switch {
    width: 32px;
    color: #fff;
    background: transparent;
    backdrop-filter: none;
    box-shadow: none;
    border-radius: 0;
  }
  .video-switch:hover { background: transparent; color: #fff; }
  .view-reset[hidden] { display: none; }
  .video-switch:focus-visible { outline-color: #fff; }
  .video-switch svg {
    width: 16px;
    height: 16px;
    filter: drop-shadow(0 0 1px rgba(0,0,0,.9)) drop-shadow(0 1px 2px rgba(0,0,0,.65));
  }
  .video-switch[data-paused="true"] .pause-icon,
  .video-switch[data-paused="false"] .play-icon { display: none; }
  .music-switch[data-paused="true"] .music-on,
  .music-switch[data-paused="false"] .music-off { display: none; }
  @media (prefers-reduced-motion: reduce) {
    .language-switch { transition: none; }

  }
  :global(:root) {
    --paper: #fdfaf3;
    --ink: #1a1a1a;
    --muted: #6b6b6b;
    --bg-1: #c7d8e7;
    --bg-2: #a6bfd5;
    --accent: #0000ef;
    --pink: #ffd4dc;
    --blue: #cfe3ff;
    --yellow: #fff3a8;
  }

  :global(html),
  :global(body.playground) {
    height: 100%;
    margin: 0;
    overflow: hidden;
    background: var(--bg-1);
    color: var(--ink);
    overscroll-behavior: none;
  }

  .viewport {
    position: fixed;
    inset: 0;
    overflow: hidden;
    cursor: grab;
    touch-action: none;
    background: var(--bg-1) var(--wallpaper) center / cover no-repeat;
  }

  .viewport.panning {
    cursor: grabbing;
  }

  @media (min-width: 900px) {
    .viewport { background-image: var(--wallpaper-wide); }
  }

  .canvas {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0;
    height: 0;
    transform-origin: 0 0;
    z-index: 1;
  }
  .wallpaper-video {
    opacity: 0;
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    pointer-events: none;
    filter: blur(1px);
    transform: scale(1.012);
  }

  .sticker {
    position: absolute;
    user-select: none;
    -webkit-user-drag: none;
    cursor: grab;
    touch-action: none;
    transform-origin: 50% 50%;
    transform: translate(var(--sx, 0), var(--sy, 0)) rotate(var(--srot, 0deg));
    transition:
      transform 280ms cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 180ms ease,
      filter 180ms ease;
  }

  .sticker.dragging {
    will-change: transform;
    cursor: grabbing;
    z-index: 999;
    transition: none;
  }

  .sticker.tidying {
    transition: none;
  }

  .sticker:hover:not(.dragging) {
    filter: brightness(1.03);
    transform: translate(var(--sx, 0), var(--sy, 0)) rotate(calc(var(--srot, 0deg) + 3deg)) scale(1.04);
  }

  .sticker--paper {
    --paper-line-height: 24px;
    --paper-top-padding: 28px;
    --paper-rule-position: calc(var(--paper-line-height) / 2 + .45em);
    width: 320px;
    padding: var(--paper-top-padding) 26px 32px;
    background: var(--paper);
    color: var(--ink);
    font-size: 16px;
    line-height: var(--paper-line-height);
    box-shadow:
      0 1px 0 rgba(0, 0, 0, 0.04),
      0 12px 24px -10px rgba(0, 0, 0, 0.25),
      0 30px 50px -20px rgba(0, 0, 0, 0.2);
    border-radius: 2px;
    background-image:
      linear-gradient(var(--paper), var(--paper)),
      repeating-linear-gradient(
        to bottom,
        transparent 0,
        transparent var(--paper-rule-position),
        rgba(0, 0, 0, 0.04) var(--paper-rule-position),
        rgba(0, 0, 0, 0.04) calc(var(--paper-rule-position) + 1px),
        transparent calc(var(--paper-rule-position) + 1px),
        transparent var(--paper-line-height)
      );
    background-position: 0 0, 0 var(--paper-top-padding);
    background-blend-mode: multiply;
  }

  .sticker--paper p {
    margin-bottom: var(--paper-line-height);
  }

  .sticker--paper p:last-child {
    margin-bottom: 0;
  }

  .sticker--paper .muted {
    color: var(--muted);
    font-style: italic;
  }

  .sticker--paper strong {
    background: linear-gradient(transparent 60%, #fff3a8 60%);
    padding: 0 2px;
  }

  .sticker--paper a.paper-link {
    color: var(--ink);
    text-decoration: none;
    background: linear-gradient(transparent 60%, #cfe3ff 60%);
    padding: 0 2px;
    font-weight: 600;
    transition: background 160ms ease;
  }

  .sticker--paper a.paper-link:hover {
    background: linear-gradient(transparent 0%, #cfe3ff 0%);
  }

  .sticker--photo {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .sticker--photo img {
    display: block;
    width: 240px;
    height: 240px;
    object-fit: cover;
    background: #eee;
    box-shadow:
      0 1px 0 rgba(0, 0, 0, 0.05),
      0 14px 28px -12px rgba(0, 0, 0, 0.35),
      0 30px 40px -22px rgba(0, 0, 0, 0.2);
    pointer-events: none;
    image-rendering: -webkit-optimize-contrast;
    image-rendering: high-quality;
  }

  .photo-label {
    position: relative;
    margin-top: -14px;
    font-family: "Lucida Console", Consolas, Tahoma, monospace;
    font-size: 11px;
    background: rgba(255, 255, 255, 0.65);
    backdrop-filter: blur(8px) saturate(1.3);
    -webkit-backdrop-filter: blur(8px) saturate(1.3);
    color: #1c3656;
    padding: 4px 12px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.6);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.7),
      inset 0 -1px 0 rgba(0, 30, 70, 0.1),
      0 4px 12px -3px rgba(0, 30, 70, 0.3);
    transform: rotate(-2deg);
    z-index: 2;
    white-space: nowrap;
  }

  .sticker--chip {
    display: inline-flex;
    align-items: center;
    padding: 10px 12px 10px 18px;
    background: #fff;
    color: var(--ink);
    text-decoration: none;
    font-weight: 500;
    font-size: 15px;
    white-space: nowrap;
    border-radius: 999px;
    box-shadow:
      inset 0 0 0 1.5px var(--ink),
      0 6px 14px -6px rgba(0, 0, 0, 0.3);
    transition:
      transform 120ms ease,
      box-shadow 180ms ease,
      background 160ms ease;
  }

  .sticker--chip span {
    padding-right: 0 !important;
  }

  .sticker--chip::after {
    content: '↗';
    margin-left: 10px;
    font-size: 1.25em;
    font-weight: 800;
    line-height: 1;
    opacity: 0.65;
    transform: translateY(-2px);
    transition:
      transform 180ms ease,
      opacity 180ms ease;
  }

  .sticker--chip:hover {
    background: var(--ink);
    color: #fff;
  }

  .sticker--chip:hover::after {
    opacity: 1;
    transform: translate(2px, -4px);
  }

  .chip--email {
    background: #fff4c2;
  }

  .chip--cv {
    background: linear-gradient(to bottom, rgba(250,253,255,.88) 0%, rgba(230,241,250,.78) 48%, rgba(204,224,240,.72) 52%, rgba(220,235,247,.82) 100%);
    color: #35516a;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    text-shadow: 0 1px 0 rgba(255,255,255,.65);
    box-shadow: inset 0 0 0 1px rgba(53,81,106,.35), inset 0 1px 0 rgba(255,255,255,.8), 0 4px 10px -6px rgba(25,55,85,.2);
  }

  .chip--work {
    background: linear-gradient(to bottom, #699dcb 0%, #477fb2 48%, #326b9e 52%, #285f91 100%);
    color: #fff;
    font-weight: 600;
    text-shadow: 0 1px 1px rgba(15,45,75,.3);
    box-shadow: inset 0 0 0 1px #285c88, inset 0 2px 0 rgba(255,255,255,.4), 0 6px 14px -5px rgba(20,65,105,.4);
  }
  .sticker--chip.chip--work:hover { background: linear-gradient(to bottom, #7aaedb, #3674a9); }
  .sticker--chip.chip--cv:hover { background: linear-gradient(to bottom, rgba(255,255,255,.96) 0%, rgba(239,247,253,.9) 48%, rgba(218,236,249,.85) 52%, rgba(233,244,252,.92) 100%); color: #243d54; }

  .sticker--links { width: 180px; }
  .chip--links-toggle { list-style: none; cursor: pointer; }
  .chip--links-toggle::-webkit-details-marker { display: none; }
  .chip--links-toggle::after { display: none; }
  .links-chevron { display: block; width: 16px; height: 16px; margin-left: 8px; flex-shrink: 0; }
  .sticker--links[open] .links-chevron { transform: rotate(180deg); }
  .profile-links {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    width: 180px;
    padding: 8px;
    border: 1px solid rgba(255,255,255,.65);
    border-radius: 14px;
    background: rgba(244,249,253,.92);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
    box-shadow: 0 8px 24px rgba(20,45,70,.2);
  }
  .profile-links a { display: flex; width: 100%; justify-content: space-between; gap: 16px; padding: 10px 12px; border-radius: 7px; color: #29475f; font-size: 14px; text-decoration: underline; text-underline-offset: 3px; }
  .profile-links a:hover { background: rgba(205,225,241,.65); }
  .profile-links a span { padding: 0; }

  .chip--linkedin {
    background: #cfe3ff;
  }

  .chip--telegram {
    background: #e0d4ff;
  }

  .chip--photos {
    background: #ffe0bf;
  }

  .sticker--note {
    width: 144px;
    padding: 14px 12px;
    display: flex;
    flex-direction: column;
    gap: 5px;
    box-shadow:
      0 1px 0 rgba(0, 0, 0, 0.05),
      0 10px 22px -10px rgba(0, 0, 0, 0.3);
    clip-path: polygon(0 0, 100% 0, 100% 92%, 94% 100%, 0 100%);
  }

  .note--pink {
    background: var(--pink);
  }

  .note--blue {
    background: var(--blue);
  }

  .note--yellow {
    background: var(--yellow);
  }

  .sticker--note .note-label {
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: rgba(0, 0, 0, 0.5);
  }

  .sticker--note strong {
    font-size: 18px;
    line-height: 1.1;
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .view-reset { display: none; }
    :global(body.playground) { overflow: hidden; }
    .page-controls { top: max(16px, env(safe-area-inset-top)); right: max(16px, env(safe-area-inset-right)); }
    .language-switch { height: 44px; }
    .language-links .language-option { width: 44px; height: 44px; }
    .video-switch { width: 44px; }
    .viewport { overflow-y: auto; overflow-x: hidden; touch-action: pan-y; }
    .canvas {
      position: relative;
      left: 0;
      top: 0;
      width: min(100%, 440px);
      height: auto;
      margin: 0 auto;
      padding: calc(88px + env(safe-area-inset-top)) 24px calc(40px + env(safe-area-inset-bottom));
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px 16px;
      transform: none !important;
    }
    .sticker { position: relative; min-width: 0; transform: rotate(var(--srot, 0deg)) !important; }
    .sticker--paper {
      --paper-line-height: 25.6px;
      --paper-top-padding: 24px;
