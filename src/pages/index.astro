---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/globals.css';
// Window markup is created at runtime, so these selectors must stay global.
import '../styles/window.css';

const baseUrl = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const route = (name: string) => `${baseUrl}${name}/`;
---

<BaseLayout
  title="Ilya Sudakov"
  description="Ilya Sudakov — personal playground"
  bodyClass="playground"
>
  <button class="language-switch" data-language-switch data-language="ru" type="button" aria-label="Переключить на английский" title="Переключить на английский">
    <span class="language-tint" aria-hidden="true"></span>
    <span class="language-label" data-language-label>RU</span>
  </button>
  <div class="viewport" id="viewport" style={`--wallpaper: url('${baseUrl}assets/aqua-wallpaper.webp')`}>
    <div class="canvas" id="canvas">
      <div class="sticker sticker--paper" data-x="-220" data-y="-200" data-rot="-2.5">
        <p>Привет, меня зовут <strong>Илья</strong>.</p>
        <p>
          Продакт-инженер в <a
            href="https://improvado.io"
            target="_blank"
            rel="noopener"
            class="paper-link">Improvado</a
          >, из Санкт-Петербурга. Люблю решать сложные задачи и делать полезные продукты end-to-end:
          дизайн, код, поддержка.
        </p>
        <p>
          Можно связаться со мной <a class="paper-link" href="mailto:ilyasudakov.dev@gmail.com">по почте</a>
          или в <a class="paper-link" href="https://t.me/ilyasudakov" target="_blank" rel="noopener">Telegram</a>.
        </p>
      </div>

      <a
        class="sticker sticker--chip chip--cv"
        href={route('cv')}
        data-window={route('cv')}
        data-window-title="Резюме"
        data-x="122"
        data-y="-144"
        data-rot="2"
      >
        <span>резюме</span>
      </a>

      <a
        class="sticker sticker--chip chip--work"
        href={route('work')}
        data-window={route('work')}
        data-window-title="Портфолио"
        data-x="116"
        data-y="-200"
        data-rot="-2"
      >
        <span>портфолио</span>
      </a>

      <div class="sticker sticker--note note--pink" data-x="-220" data-y="140" data-rot="-5">
        <span class="note-label">интерес</span>
        <strong>Дизайн</strong>
      </div>

      <div class="sticker sticker--note note--yellow" data-x="-32" data-y="140" data-rot="-2">
        <span class="note-label">интерес</span>
        <strong>Музыка</strong>
      </div>
    </div>
  </div>

  <script src="../scripts/canvas.js"></script>
</BaseLayout>

<style>
  .language-switch {
    position: fixed;
    top: 20px;
    right: 24px;
    z-index: 2100;
    display: grid;
    place-items: center;
    width: 64px;
    height: 38px;
    padding: 0;
    overflow: hidden;
    isolation: isolate;
    border: 1px solid rgba(255,255,255,.55);
    border-radius: 20px;
    background: rgba(255,255,255,.5);
    backdrop-filter: blur(16px);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.85), inset 0 -2px 5px rgba(69,104,138,.12), 0 2px 8px rgba(60,65,75,.12);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: .06em;
    color: #253d52;
    cursor: pointer;
  }
  .language-label { position: relative; z-index: 1; text-shadow: 0 1px 0 rgba(255,255,255,.7); }
  .language-tint { position: absolute; inset: 0; pointer-events: none; }
  .language-tint::before, .language-tint::after {
    content: '';
    position: absolute;
    inset: 0;
    transition: opacity 500ms ease;
  }
  .language-tint::before {
    background: linear-gradient(170deg, rgba(111,166,229,.34), rgba(63,109,187,.15) 50%, rgba(215,96,111,.22));
  }
  .language-tint::after {
    background: linear-gradient(165deg, rgba(255,255,255,.5), rgba(212,86,108,.32));
    opacity: 0;
  }
  .language-switch[data-language="en"] .language-tint::before { opacity: 0; }
  .language-switch[data-language="en"] .language-tint::after { opacity: 1; }
  .language-switch:hover { border-color: rgba(255,255,255,.95); }
  .language-switch:focus-visible { outline: 2px solid #355774; outline-offset: 3px; }
  @media (prefers-reduced-motion: reduce) {
    .language-tint::before, .language-tint::after { transition: none; }
  }
  :global(:root) {
    --paper: #fdfaf3;
    --ink: #1a1a1a;
    --muted: #6b6b6b;
    --bg-1: #c7d8e7;
    --bg-2: #a6bfd5;
    --accent: #0000ef;
    --pink: #ffd4dc;
    --blue: #cfe3ff;
    --yellow: #fff3a8;
  }

  :global(html),
  :global(body.playground) {
    height: 100%;
    margin: 0;
    overflow: hidden;
    background: var(--bg-1);
    color: var(--ink);
    overscroll-behavior: none;
  }

  .viewport {
    position: fixed;
    inset: 0;
    overflow: hidden;
    cursor: grab;
    touch-action: none;
    background: var(--bg-1) var(--wallpaper) center / cover no-repeat;
  }

  .viewport.panning {
    cursor: grabbing;
  }

  .canvas {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0;
    height: 0;
    transform-origin: 0 0;
  }

  .sticker {
    position: absolute;
    user-select: none;
    -webkit-user-drag: none;
    cursor: grab;
    touch-action: none;
    transform-origin: 50% 50%;
    transform: translate(var(--sx, 0), var(--sy, 0)) rotate(var(--srot, 0deg));
    transition:
      transform 280ms cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 180ms ease,
      filter 180ms ease;
  }

  .sticker.dragging {
    will-change: transform;
    cursor: grabbing;
    z-index: 999;
    transition: none;
  }

  .sticker.tidying {
    transition: none;
  }

  .sticker:hover:not(.dragging) {
    filter: brightness(1.03);
    transform: translate(var(--sx, 0), var(--sy, 0)) rotate(calc(var(--srot, 0deg) + 3deg)) scale(1.04);
  }

  .sticker--paper {
    width: 320px;
    padding: 28px 26px 32px;
    background: var(--paper);
    color: var(--ink);
    font-size: 16px;
    line-height: 1.5;
    box-shadow:
      0 1px 0 rgba(0, 0, 0, 0.04),
      0 12px 24px -10px rgba(0, 0, 0, 0.25),
      0 30px 50px -20px rgba(0, 0, 0, 0.2);
    border-radius: 2px;
    background-image:
      linear-gradient(var(--paper), var(--paper)),
      repeating-linear-gradient(
        to bottom,
        transparent 0,
        transparent 23px,
        rgba(0, 0, 0, 0.04) 23px,
        rgba(0, 0, 0, 0.04) 24px
      );
    background-blend-mode: multiply;
  }

  .sticker--paper p {
    margin-bottom: 12px;
  }

  .sticker--paper p:last-child {
    margin-bottom: 0;
  }

  .sticker--paper .muted {
    color: var(--muted);
    font-style: italic;
  }

  .sticker--paper strong {
    background: linear-gradient(transparent 60%, #fff3a8 60%);
    padding: 0 2px;
  }

  .sticker--paper a.paper-link {
    color: var(--ink);
    text-decoration: none;
    background: linear-gradient(transparent 60%, #cfe3ff 60%);
    padding: 0 2px;
    font-weight: 600;
    transition: background 160ms ease;
  }

  .sticker--paper a.paper-link:hover {
    background: linear-gradient(transparent 0%, #cfe3ff 0%);
  }

  .sticker--photo {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .sticker--photo img {
    display: block;
    width: 240px;
    height: 240px;
    object-fit: cover;
    background: #eee;
    box-shadow:
      0 1px 0 rgba(0, 0, 0, 0.05),
      0 14px 28px -12px rgba(0, 0, 0, 0.35),
      0 30px 40px -22px rgba(0, 0, 0, 0.2);
    pointer-events: none;
    image-rendering: -webkit-optimize-contrast;
    image-rendering: high-quality;
  }

  .photo-label {
    position: relative;
    margin-top: -14px;
    font-family: "Lucida Console", Consolas, Tahoma, monospace;
    font-size: 11px;
    background: rgba(255, 255, 255, 0.65);
    backdrop-filter: blur(8px) saturate(1.3);
    -webkit-backdrop-filter: blur(8px) saturate(1.3);
    color: #1c3656;
    padding: 4px 12px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.6);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.7),
      inset 0 -1px 0 rgba(0, 30, 70, 0.1),
      0 4px 12px -3px rgba(0, 30, 70, 0.3);
    transform: rotate(-2deg);
    z-index: 2;
    white-space: nowrap;
  }

  .sticker--chip {
    display: inline-flex;
    align-items: center;
    padding: 10px 12px 10px 18px;
    background: #fff;
    color: var(--ink);
    text-decoration: none;
    font-weight: 500;
    font-size: 15px;
    white-space: nowrap;
    border-radius: 999px;
    box-shadow:
      inset 0 0 0 1.5px var(--ink),
      0 6px 14px -6px rgba(0, 0, 0, 0.3);
    transition:
      transform 120ms ease,
      box-shadow 180ms ease,
      background 160ms ease;
  }

  .sticker--chip span {
    padding-right: 0 !important;
  }

  .sticker--chip::after {
    content: '↗';
    margin-left: 10px;
    font-size: 1.25em;
    font-weight: 800;
    line-height: 1;
    opacity: 0.65;
    transform: translateY(-2px);
    transition:
      transform 180ms ease,
      opacity 180ms ease;
  }

  .sticker--chip:hover {
    background: var(--ink);
    color: #fff;
  }

  .sticker--chip:hover::after {
    opacity: 1;
    transform: translate(2px, -4px);
  }

  .chip--email {
    background: #fff4c2;
  }

  .chip--cv {
    background: rgba(255,255,255,.55);
    color: #35516a;
    backdrop-filter: blur(12px);
    box-shadow: inset 0 0 0 1px rgba(53,81,106,.35), inset 0 1px 0 rgba(255,255,255,.8), 0 4px 10px -6px rgba(25,55,85,.2);
  }

  .chip--work {
    background: linear-gradient(to bottom, #699dcb 0%, #477fb2 48%, #326b9e 52%, #285f91 100%);
    color: #fff;
    font-weight: 600;
    text-shadow: 0 1px 1px rgba(15,45,75,.3);
    box-shadow: inset 0 0 0 1px #285c88, inset 0 2px 0 rgba(255,255,255,.4), 0 6px 14px -5px rgba(20,65,105,.4);
  }
  .sticker--chip.chip--work:hover { background: linear-gradient(to bottom, #7aaedb, #3674a9); }
  .sticker--chip.chip--cv:hover { background: rgba(255,255,255,.85); color: #243d54; }

  .chip--linkedin {
    background: #cfe3ff;
  }

  .chip--telegram {
    background: #e0d4ff;
  }

  .chip--photos {
    background: #ffe0bf;
  }

  .sticker--note {
    width: 172px;
    padding: 18px 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    box-shadow:
      0 1px 0 rgba(0, 0, 0, 0.05),
      0 10px 22px -10px rgba(0, 0, 0, 0.3);
    clip-path: polygon(0 0, 100% 0, 100% 92%, 94% 100%, 0 100%);
  }

  .note--pink {
    background: var(--pink);
  }

  .note--blue {
    background: var(--blue);
  }

  .note--yellow {
    background: var(--yellow);
  }

  .sticker--note .note-label {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: rgba(0, 0, 0, 0.5);
  }

  .sticker--note strong {
    font-size: 20px;
    line-height: 1.1;
    font-weight: 600;
  }

  @media (max-width: 640px) {
    :global(body.playground) { overflow: hidden; }
    .language-switch { top: max(16px, env(safe-area-inset-top)); right: max(16px, env(safe-area-inset-right)); height: 44px; }
    .viewport { overflow-y: auto; overflow-x: hidden; touch-action: pan-y; }
    .canvas {
      position: relative;
      left: 0;
      top: 0;
      width: min(100%, 440px);
      height: auto;
      margin: 0 auto;
      padding: calc(88px + env(safe-area-inset-top)) 24px calc(40px + env(safe-area-inset-bottom));
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px 16px;
      transform: none !important;
    }
    .sticker { position: relative; min-width: 0; transform: rotate(var(--srot, 0deg)) !important; }
    .sticker--paper {
      grid-column: 1 / -1;
      width: 100%;
      padding: 24px;
      font-size: 16px;
      line-height: 1.6;
    }
    .sticker--chip { justify-content: center; width: 100%; min-height: 48px; padding: 12px 10px; font-size: 14px; }
    .chip--work { grid-row: 2; grid-column: 1; }
    .chip--cv { grid-row: 2; grid-column: 2; }
    .sticker--note { width: 100%; padding: 18px 14px; }
    :global(body.mobile-window-open .viewport) { overflow: hidden; }
    :global(body.mobile-window-open .sticker) { pointer-events: none; }
    @media (max-width: 360px) {
      .canvas { padding-inline: 20px; gap: 20px 12px; }
      .sticker--paper { padding: 22px 20px; }
      .sticker--chip { font-size: 13px; }
    }
  }
</style>
