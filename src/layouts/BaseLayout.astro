---
import '../styles/theme.css';
interface Props {
  title: string;
  description?: string;
  lang?: string;
  bodyClass?: string;
  disableViewportZoom?: boolean;
}

const {
  title,
  description,
  lang = 'ru',
  bodyClass,
  disableViewportZoom = false,
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      (() => {
        let theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        try {
          const saved = localStorage.getItem('site-theme');
          if (saved === 'light' || saved === 'dark') theme = saved;
          if (window.parent !== window && window.parent.document.documentElement.dataset.theme) theme = window.parent.document.documentElement.dataset.theme;
        } catch {}
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <meta
      name="viewport"
      content={`width=device-width, initial-scale=1.0${disableViewportZoom ? ', user-scalable=no' : ''}`}
    />
    {description && <meta name="description" content={description} />}
    <title>{title}</title>
    <slot name="head" />
    <link rel="icon" type="image/x-icon" href={`${baseUrl}assets/favicon.ico`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <script is:inline src={`${baseUrl}scripts/posthog.js`}></script>
  </head>
  <body class={bodyClass}>
    <slot />
    <script src="../scripts/language.js"></script>
    <script src="../scripts/theme.js"></script>
    <script src="../scripts/page-navigation.js"></script>
  </body>
</html>
