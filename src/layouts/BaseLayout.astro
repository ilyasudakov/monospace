---
interface Props {
  title: string;
  description?: string;
  lang?: string;
  bodyClass?: string;
  disableViewportZoom?: boolean;
}

const {
  title,
  description,
  lang = 'ru',
  bodyClass,
  disableViewportZoom = false,
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content={`width=device-width, initial-scale=1.0${disableViewportZoom ? ', user-scalable=no' : ''}`}
    />
    {description && <meta name="description" content={description} />}
    <title>{title}</title>
    <link rel="icon" type="image/x-icon" href={`${baseUrl}assets/favicon.ico`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <script is:inline src={`${baseUrl}scripts/posthog.js`}></script>
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
